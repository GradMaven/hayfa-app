# Copy to .env.local for development. Never commit real secrets.
# See docs/ENVIRONMENT.md for what each variable does and how it's used.

# --- Database ---------------------------------------------------------
DATABASE_URL="postgresql://hafya:hafya_dev_password@localhost:5432/hafya_dev"

# --- Sessions / auth ----------------------------------------------------
# 64-char hex string (32 bytes) — the AES-256 key used to encrypt MFA (TOTP)
# secrets at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-random-64-char-hex-string"
SESSION_COOKIE_NAME="hafya_session"
SESSION_TTL_DAYS="30"

# --- Object storage (S3-compatible; MinIO locally) ----------------------
STORAGE_PROVIDER="s3"
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="hafya-documents-dev"
STORAGE_ACCESS_KEY_ID="hafya_minio"
STORAGE_SECRET_ACCESS_KEY="hafya_minio_password"
STORAGE_FORCE_PATH_STYLE="true"

# --- Feature flags (see src/lib/feature-flags.ts) -----------------------
# NEXT_PUBLIC_-prefixed and read via static references so Next.js inlines
# them into the browser bundle too — several gate Client Component UI, not
# just server routes (e.g. whether the "Explain this" AI button renders at
# all). None of these are secrets — they're on/off switches.
NEXT_PUBLIC_ENABLE_AI="false"
NEXT_PUBLIC_ENABLE_OCR="true"
NEXT_PUBLIC_ENABLE_WEARABLES="false"
NEXT_PUBLIC_ENABLE_SMS="false"
NEXT_PUBLIC_ENABLE_USSD="false"
NEXT_PUBLIC_ENABLE_PROVIDER_PORTAL="true"
NEXT_PUBLIC_ENABLE_BILLING="false"
NEXT_PUBLIC_ENABLE_ORGANIZATIONS="false"

# --- AI provider (only used when NEXT_PUBLIC_ENABLE_AI=true) -------------
# AI_PROVIDER=mock (or unset) uses the built-in deterministic mock — no
# network call, no data leaves the process. AI_PROVIDER=anthropic + a real
# AI_API_KEY sends requests to the Anthropic API (Claude) — see
# docs/ai-architecture.md before ever pointing this at real patient data.
AI_PROVIDER="mock"
AI_API_KEY=""
AI_MODEL="claude-haiku-4-5-20251001"

# --- OCR provider (only used when NEXT_PUBLIC_ENABLE_OCR=true) -----------
# OCR_PROVIDER=mock (or unset) uses the built-in deterministic mock — no
# network call, no data leaves the process. OCR_PROVIDER=anthropic sends the
# uploaded document (image or PDF) to Claude's vision/document input for
# extraction, reusing AI_API_KEY above (same vendor account, not a separate
# key) — see docs/ai-architecture.md.
OCR_PROVIDER="mock"
OCR_MODEL="claude-sonnet-5"

# --- Email (in-app + email are the only wired notification channels) ----
# EMAIL_PROVIDER=console logs emails to the server terminal — zero setup.
# EMAIL_PROVIDER=smtp sends real email via SMTP_* below — works against
# Mailpit locally (docker compose up -d) or any real SMTP vendor (Amazon
# SES, SendGrid, Postmark, Mailgun, Gmail) in production; only these four
# vars change between them, never application code.
EMAIL_FROM="Hafya <no-reply@hafya.health>"
EMAIL_PROVIDER="console"
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""

# --- Malware scanning (§18 upload pipeline) -------------------------------
# MALWARE_SCAN_PROVIDER=clamav (default) scans every upload against a real
# ClamAV daemon — CLAMAV_HOST/CLAMAV_PORT below point at the local
# `docker compose up -d` instance by default, or any reachable ClamAV in
# production. If the scanner can't be reached, uploads fail closed with a
# retry message — never silently treated as clean. MALWARE_SCAN_PROVIDER=none
# is an explicit, visible opt-out (e.g. for CI) — the resulting document is
# honestly marked SKIPPED, not CLEAN.
MALWARE_SCAN_PROVIDER="clamav"
CLAMAV_HOST="localhost"
CLAMAV_PORT="3310"

# --- SMS (only used when NEXT_PUBLIC_ENABLE_SMS=true) ---------------------
# SMS_PROVIDER=console (default) logs SMS to the server terminal — zero
# setup. SMS_PROVIDER=africastalking sends real SMS via Africa's Talking
# (https://africastalking.com) — use username=sandbox with a sandbox app's
# API key for free testing, or your production app's username/key to send
# real messages. SMS_SENDER_ID is optional (a registered alphanumeric ID or
# short code); omitted, Africa's Talking uses its shared default sender.
SMS_PROVIDER="console"
SMS_API_KEY=""
SMS_USERNAME=""
SMS_SENDER_ID=""

# --- App -----------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
