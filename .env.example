# Copy to .env.local for development. Never commit real secrets.
# See docs/ENVIRONMENT.md for what each variable does and how it's used.

# --- Database ---------------------------------------------------------
DATABASE_URL="postgresql://hafya:hafya_dev_password@localhost:5432/hafya_dev"

# --- Sessions / auth ----------------------------------------------------
# 64-char hex string (32 bytes) — the AES-256 key used to encrypt MFA (TOTP)
# secrets at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-random-64-char-hex-string"
SESSION_COOKIE_NAME="hafya_session"
SESSION_TTL_DAYS="30"

# --- Object storage (S3-compatible; MinIO locally) ----------------------
STORAGE_PROVIDER="s3"
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="hafya-documents-dev"
STORAGE_ACCESS_KEY_ID="hafya_minio"
STORAGE_SECRET_ACCESS_KEY="hafya_minio_password"
STORAGE_FORCE_PATH_STYLE="true"

# --- Feature flags (see src/lib/feature-flags.ts) -----------------------
ENABLE_AI="false"
ENABLE_OCR="true"
ENABLE_WEARABLES="false"
ENABLE_SMS="false"
ENABLE_USSD="false"
ENABLE_PROVIDER_PORTAL="true"
ENABLE_BILLING="false"
ENABLE_ORGANIZATIONS="false"

# --- AI provider (only used when ENABLE_AI=true) -------------------------
AI_PROVIDER="mock"
AI_API_KEY=""

# --- Email (in-app + email are the only wired notification channels) ----
# EMAIL_PROVIDER=console logs emails to the server terminal — zero setup.
# EMAIL_PROVIDER=smtp sends real email via SMTP_* below — works against
# Mailpit locally (docker compose up -d) or any real SMTP vendor (Amazon
# SES, SendGrid, Postmark, Mailgun, Gmail) in production; only these four
# vars change between them, never application code.
EMAIL_FROM="Hafya <no-reply@hafya.health>"
EMAIL_PROVIDER="console"
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""

# --- App -----------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
